root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
# Markdown hard-wraps are an author choice, not a lint; KILN wraps
# prose at ~72 by convention so diffs read like sentences.

[*.{yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[*.sh]
indent_size = 4
